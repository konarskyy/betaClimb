# PostgreSQL (zgodne z docker-compose.yml w katalogu głównym)
DATABASE_URL="postgresql://betaclimb:betaclimb@localhost:5432/betaclimb?schema=public"

# Sekrety JWT — w realnym wdrożeniu długie, losowe i trzymane w sekretach (nie w repo)
JWT_ACCESS_SECRET="zmien-mnie-access-sekret-min-32-znaki-000"
JWT_REFRESH_SECRET="zmien-mnie-refresh-sekret-min-32-znaki-00"

# Czas życia tokenów
ACCESS_TTL="15m"
REFRESH_TTL="30d"

# Serwer
PORT=4000
HOST="0.0.0.0"

# Storage zdjęć tras (lokalny katalog w dev)
STORAGE_DIR="./storage"
# Publiczny adres bazowy serwera (do budowania URL-i zdjęć)
PUBLIC_URL="http://localhost:4000"
